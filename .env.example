# ── Polygon.io ──────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key

# ── LuminaFlow (GEX / DEX / VEX options data) ───────────
LUMINAFLOW_API_KEY=your_luminaflow_api_key
LUMINAFLOW_BASE_URL=https://api.luminaflow.app/api/export/gex

# ── Discord ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id            # swing trade signals
DISCORD_ALERTS_CHANNEL_ID=your_channel_id     # stop/target hit alerts
DISCORD_MORNING_CHANNEL_ID=your_channel_id    # morning brief
DISCORD_GEX_CHANNEL_ID=your_channel_id
DISCORD_NEWS_CHANNEL_ID=your_channel_id

# ── Obsidian (local only — leave blank on Railway) ───────
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_TRADING_FOLDER=Trading-Bot

# ── Mention context files (optional, local paths) ────────
SUMMARY_MD_PATH=/path/to/SecondBrain/SUMMARY.md
CLAUDE_MD_PATH=/path/to/Trading-Bot/CLAUDE.md

# ── Strategy config ───────────────────────────────────────
CONVICTION_THRESHOLD=70          # min score (0-100) to post a signal
MIN_RR_RATIO=2.0                 # minimum risk/reward to consider a trade
MORNING_BRIEF_TIME=09:00         # ET — when to post morning brief
POSITION_STORE_PATH=positions.json

# ── General ──────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO

# ── Anthropic ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key
